<launch>
    <!-- Declare arguments -->
    <arg name="urdf_path" default="$(find-pkg-share scara_description)/urdf/basic_scara.urdf.xacro"/>
    <arg name="rviz_config_path" default="$(find-pkg-share scara_description)/rviz/display.rviz"/>

    <!-- Set Gazebo model path -->
    <set_env name="GAZEBO_MODEL_PATH" value="$(find-pkg-prefix scara_description)/share" />

    <!-- Robot State Publisher -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- Joint State Publisher GUI -->
    <!-- <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" /> -->

    <!-- RViz2 -->
    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)" launch-prefix="bash -c 'sleep 5; $0 $@'">
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- Start Gazebo -->
    <include file="$(find-pkg-share gazebo_ros)/launch/gazebo.launch.py" />

    <!-- Spawn robot from /robot_description topic -->
    <node pkg="gazebo_ros" exec="spawn_entity.py"
        args="-entity scara_robot -topic robot_description" />
</launch>